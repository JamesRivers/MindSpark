# MindSpark self-hosted cloud mode - environment
# Copy to /etc/mindspark/env (chmod 600) on the VM.

# Where the app listens. Keep it on loopback; cloudflared runs on the same host.
HOST=127.0.0.1
PORT=8080

# Public HTTPS URL people open. This must be the exact origin registered in the
# GitHub OAuth App (homepage URL) and the tunnel hostname. No trailing slash.
APP_ORIGIN=https://mindspark.example.com

# GitHub OAuth App -> https://github.com/settings/developers
# Authorization callback URL must be: ${APP_ORIGIN}/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The repository maps are committed to. Use a shared repo (owner/name) so every
# signed-in user with write access stores maps in the same place. It must exist
# already and the GitHub accounts must have write access.
DEFAULT_REPO=owner/mindspark-maps

# Optional: restrict sign-in to these GitHub logins (comma separated).
# Leave empty to allow any GitHub account that can authorize the OAuth App.
# Only accounts with write access to DEFAULT_REPO can actually save.
ALLOWED_GITHUB_LOGINS=

# Optional: extra origins for custom LLM providers (BYOK), space separated.
# Built-in providers (Anthropic, OpenAI, OpenRouter, Groq) are already allowed.
# Example: EXTRA_CONNECT_SRC=https://api.mistral.ai http://192.168.1.50:11434
EXTRA_CONNECT_SRC=
